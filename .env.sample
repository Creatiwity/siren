RUST_LOG=sirene=debug
SIRENE_ENV=development
HOST=localhost
PORT=3000
BASE_URL=http://localhost:3000
API_KEY=
DATABASE_URL=postgresql://sirene:sirenepw@127.0.0.1:5432/sirene
DATABASE_POOL_SIZE=100
INSEE_CREDENTIALS=
# Geocoding (build with --features geocoding): index built by `update geocoding`
# GEOCODING_INDEX_PATH=./data/geocoding/index.bin
# true: do not migrate on startup, only check (run `sirene migrate` first)
SKIP_MIGRATIONS=false
# Seconds to keep serving after SIGTERM with /health/ready failing (0 locally)
SHUTDOWN_DELAY_SECONDS=0
